#!/bin/sh
set -eu

# Only asset/build changes require Node and the minifiers.
if ! git diff --cached --name-only | grep -Eq '^(public/js/(Cart|Variables)(\.min)?\.js|public/css/setup(\.min)?\.css|package(-lock)?\.json|\.github/scripts/build-assets\.cjs)$'; then
    exit 0
fi

if ! command -v node >/dev/null 2>&1; then
    echo 'Asset checks require Node.js. Install Node.js 24.15+ and run npm ci.' >&2
    exit 1
fi
node .github/scripts/build-assets.cjs --check --staged

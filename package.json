{
  "name": "woo-poly-integration-tools",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "docs:build": "node .github/scripts/build-guide.cjs",
    "build:assets": "node .github/scripts/build-assets.cjs",
    "check:assets": "node .github/scripts/build-assets.cjs --check",
    "build:js": "npm run build:assets",
    "check:js": "npm run check:assets",
    "test:js": "node --test tests/js/*.test.cjs",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "release": "release-it",
    "docs:check": "node .github/scripts/build-guide.cjs --check"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@release-it/bumper": "8.0.1",
    "esbuild": "0.28.2",
    "git-cliff": "2.14.2",
    "highlight.js": "11.12.0",
    "markdown-it": "14.3.3",
    "release-it": "21.1.2",
    "terser": "5.51.2"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "6.2.3"
    }
  }
}
